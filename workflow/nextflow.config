params {
    // Input reads — tumor and normal specified separately
    tumor_r1    = "data/hcc1143/tumor_R1.fastq.gz"
    tumor_r2    = "data/hcc1143/tumor_R2.fastq.gz"
    normal_r1   = "data/hcc1143/normal_R1.fastq.gz"
    normal_r2   = "data/hcc1143/normal_R2.fastq.gz"

    // Sample names — must match the read group SM tag written by BWA-MEM2
    tumor_name  = "HCC1143_tumor"
    normal_name = "HCC1143_normal"

    // Reference genome (bgzip format required by GATK)
    fasta       = "data/reference/chr22.fa.gz"

    // VEP offline cache directory
    vep_cache   = "${System.getenv('HOME')}/.vep"

    // Set to false to skip VEP annotation (required on Mac Apple Silicon —
    // the VEP conda package does not run on osx-arm64; use -profile docker on Linux)
    run_vep     = false

    // Output directory
    outdir      = "results"
}

process {
    cpus   = 2
    memory = '4 GB'

    withName: 'BWAMEM2_INDEX' {
        memory = '16 GB'
    }
    withName: 'BWAMEM2_ALIGN' {
        cpus   = 4
        memory = '8 GB'
    }
    withName: 'MUTECT2' {
        memory = '8 GB'
    }
    withName: 'VEP' {
        memory = '8 GB'
    }
}

profiles {

    // ── Local Mac (Apple Silicon / Intel) ───────────────────────────────────
    // Run with: nextflow run workflow/main.nf -profile local
    local {
        conda.enabled  = true
        docker.enabled = false
    }

    // ── Docker (Linux / CI / cloud) ─────────────────────────────────────────
    // Run with: nextflow run workflow/main.nf -profile docker
    docker {
        docker.enabled    = true
        docker.runOptions = '--platform linux/amd64'
        conda.enabled     = false
    }

    // ── Singularity (HPC clusters) ───────────────────────────────────────────
    // Run with: nextflow run workflow/main.nf -profile singularity
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
    }

}
